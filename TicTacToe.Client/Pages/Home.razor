@page "/"
@using TicTacToe.Client.Service
@using TicTacToe.Client.Components
@inject AuthService authService
@inject ScoreService scoreService
@inject NavigationManager navigation

<div class="page">
    <ScoreBoard />
    <h1 class="title">Крестики-Нолики</h1>
    <div class="menu-container">
        <button class="btn-start" @onclick="PlayWithComputer">Тренироваться</button>
        <button class="btn-start" @onclick="CreateGame">Создать игру</button>
        <button class="btn-start" @onclick="JoinGame">Присоединиться</button>
        <button class="btn-start" @onclick="LoadGame">Загрузить</button>
        <button class="btn-start" @onclick="Logout">Выйти</button>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        if (!authService.IsAuthenticated)
        {
            navigation.NavigateTo("/login");
        }
    }

    private void PlayWithComputer() => navigation.NavigateTo("/game/computer/new");

    private void CreateGame() => navigation.NavigateTo("/game/human/new");

    private void JoinGame() => navigation.NavigateTo("/game/join");

    private void LoadGame() => navigation.NavigateTo("/game/my");

    private void Logout()
    {
        authService.Clear();
        scoreService.Reset();
        navigation.NavigateTo("/login");
    }
}