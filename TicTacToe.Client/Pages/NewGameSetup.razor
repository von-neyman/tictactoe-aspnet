@page "/game/computer/new"
@page "/game/human/new"
@using TicTacToe.Client.Service
@using TicTacToe.Client.Components
@using TicTacToe.Client.Enum
@inject GameClient gameClient
@inject AuthService authService
@inject ScoreService scoreService
@inject NavigationManager navigation

<div class="page">
    <ScoreBoard />
    <h1 class="title">Новая игра</h1>
    <div class="new-game-setup">
        <div class="setup-label">Выберите символ</div>
        <div class="symbol-choices">
            <label class="choice">
                <input type="radio" name="symbol" value="X" @onchange="() => playerSymbol = CellState.X" checked />
                ✕
            </label>
            <label class="choice">
                <input type="radio" name="symbol" value="O" @onchange="() => playerSymbol = CellState.O" />
                ◯
            </label>
        </div>

        @if (isComputerGame)
        {
            <div class="setup-label">Выберите сложность</div>
            <div class="difficulty-choices">
                <label class="choice">
                    <input type="radio" name="difficulty" value="0" @onchange="() => difficulty = 0" />
                    Балбес
                </label>
                <label class="choice">
                    <input type="radio" name="difficulty" value="1" @onchange="() => difficulty = 1" />
                    Неосторожный
                </label>
                <label class="choice">
                    <input type="radio" name="difficulty" value="2" @onchange="() => difficulty = 2" />
                    Опытный
                </label>
                <label class="choice">
                    <input type="radio" name="difficulty" value="9" @onchange="() => difficulty = 9" checked />
                    Мастер
                </label>
            </div>
        }

        <button class="btn-start" @onclick="StartGame">Начать</button>
        <button class="btn-start" @onclick="BackToMenu">Вернуться</button>
    </div>
</div>

@code {
    private CellState playerSymbol = CellState.X;
    private int difficulty = 9;
    private bool isComputerGame;

    protected override void OnInitialized()
    {
        if (!authService.IsAuthenticated)
        {
            navigation.NavigateTo("/login");
            return;
        }
        isComputerGame = navigation.Uri.Contains("/game/computer/new");
    }

    private async Task StartGame()
    {
        var game = await gameClient.CreateGameAsync(playerSymbol, isComputerGame ? difficulty : null);
        if (game == null) return;
        navigation.NavigateTo($"/game/{game.Id}");
    }

    private void BackToMenu()
    {
        navigation.NavigateTo("/");
    }
}